#!/usr/bin/env python3
"""Check everything WDA needs and print one JSON object with the next fix

Read-only: lists devices and inspects files, never installs or launches anything.
"""
import glob
import json
import os
import plistlib
import shutil
import subprocess
import sys
import urllib.request

WDA_HOME = os.path.dirname(os.path.abspath(__file__))


def shell_config(*names):
    """Read settings from wda-env.sh, so the doctor checks the same defaults the scripts use"""
    script = '. "$1"; shift; for n in "$@"; do printf "%s\\0" "${!n}"; done'
    out = subprocess.run(["bash", "-c", script, "wda-env", os.path.join(WDA_HOME, "wda-env.sh"), *names],
                         capture_output=True, text=True, check=True).stdout
    return dict(zip(names, out.split("\0")))


CONFIG = shell_config("WDA_DERIVED", "WDA_TEAM", "WDA_BUNDLE_ID", "WDA_BASE_URL")
DERIVED = CONFIG["WDA_DERIVED"]
TEAM = CONFIG["WDA_TEAM"]
BUNDLE = CONFIG["WDA_BUNDLE_ID"]
# wda-start builds the runner and registers the phone itself, so these only inform
BUILT_BY_START = {"build_products", "build_bundle_id", "profile_has_device"}
BASE = CONFIG["WDA_BASE_URL"]
UDID = os.environ.get("IOS_UDID", "")
checks = []


def run(*cmd, timeout=60):
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return p.returncode, p.stdout, p.stderr
    except (OSError, subprocess.TimeoutExpired) as e:
        return 127, "", str(e)


def check(name, ok, detail, fix=""):
    checks.append({"name": name, "ok": bool(ok), "detail": detail, **({} if ok else {"fix": fix})})


def main():
    # xcode
    rc, out, err = run("xcodebuild", "-version")
    check("xcode", rc == 0, out.replace("\n", " ").strip() or err.strip(),
          "install Xcode, then run: sudo xcodebuild -runFirstLaunch")
    rc, _, _ = run("xcodebuild", "-checkFirstLaunchStatus")
    check("xcode_first_launch", rc == 0, "first launch tasks done" if rc == 0 else "first launch not finished",
          "run: sudo xcodebuild -runFirstLaunch")

    # signing team
    rc, out, _ = run("security", "find-certificate", "-a", "-c", "Apple Development", "-p")
    teams = set()
    for pem in out.split("-----END CERTIFICATE-----"):
        if "BEGIN CERTIFICATE" in pem:
            r = subprocess.run(["openssl", "x509", "-noout", "-subject"], input=pem + "-----END CERTIFICATE-----\n", capture_output=True, text=True)
            for part in r.stdout.replace("/", ",").split(","):
                if part.strip().startswith("OU="):
                    teams.add(part.strip()[3:].strip())
    check("signing_team", TEAM in teams, "team %s; Apple Development certs for teams: %s" % (TEAM, sorted(teams) or "none"),
          "open Xcode > Settings > Accounts and sign in to team %s, or set WDA_TEAM" % TEAM)

    # device
    if not UDID:
        check("udid", False, "IOS_UDID is not set", "export IOS_UDID=<udid>; xcrun devicectl list devices shows it")
    else:
        rc, out, err = run("xcrun", "devicectl", "list", "devices", "--json-output", "-", "--quiet")
        dev = None
        try:
            for d in json.loads(out)["result"]["devices"]:
                if d["hardwareProperties"].get("udid") == UDID:
                    dev = d
        except (ValueError, KeyError):
            pass
        if dev is None:
            check("device_listed", False, "UDID %s not in devicectl list" % UDID,
                  "plug the phone in with USB, unlock it, tap Trust, then rerun wda-doctor")
        else:
            cp, dp = dev.get("connectionProperties", {}), dev.get("deviceProperties", {})
            check("device_listed", True, "%s iOS %s, pairing %s, tunnel %s" % (dp.get("name"), dp.get("osVersionNumber"), cp.get("pairingState"), cp.get("tunnelState")))
            # developer mode is only reported once the device has been seen connected
            dm = dp.get("developerModeStatus")
            check("developer_mode", dm == "enabled", "developerModeStatus=%s" % dm,
                  "iPhone: Settings > Privacy & Security > Developer Mode > on, then restart when asked")
            check("device_connected", cp.get("tunnelState") == "connected",
                  "tunnelState=%s" % cp.get("tunnelState"),
                  "plug in the USB cable and unlock the phone")
        # usbmux is what iproxy uses; devicectl may be connected only over the network
        idev = shutil.which("idevice_id") or next(iter(glob.glob("/opt/homebrew/opt/libimobiledevice/bin/idevice_id")), None)
        if idev:
            _, ids, _ = run(idev, "-l")
            check("usb_visible", UDID in ids.split(), "idevice_id -l: %s" % (ids.split() or "no USB devices"),
                  "plug the phone in with USB (iproxy needs the USB/usbmux path), unlock it, trust this Mac")

    # iproxy
    ip = shutil.which("iproxy")
    check("iproxy", ip is not None, ip or "iproxy not on PATH", "brew install libimobiledevice")

    # build products
    xctestrun = glob.glob(DERIVED + "/Build/Products/*.xctestrun")
    app = DERIVED + "/Build/Products/Debug-iphoneos/WebDriverAgentRunner-Runner.app"
    check("build_products", bool(xctestrun) and os.path.isdir(app), xctestrun[0] if xctestrun else "no .xctestrun in " + DERIVED,
          "run: %s/wda-build (wda-start also builds on demand)" % WDA_HOME)
    if os.path.isdir(app):
        rc, _, err = run("codesign", "-dv", app)
        signed_team = [l.split("=")[1] for l in err.splitlines() if l.startswith("TeamIdentifier=")]
        check("build_signed", signed_team == [TEAM], "TeamIdentifier=%s" % (signed_team or "none"), "rebuild with wda-build")
        try:
            with open(app + "/Info.plist", "rb") as f:
                built_id = plistlib.load(f).get("CFBundleIdentifier", "")
        except (OSError, plistlib.InvalidFileException):
            built_id = ""
        check("build_bundle_id", built_id == BUNDLE + ".xctrunner", "built %s, expected %s.xctrunner" % (built_id or "nothing", BUNDLE),
              "run wda-start, which rebuilds for WDA_BUNDLE_ID")
        if UDID:
            rc, prof, _ = run("security", "cms", "-D", "-i", app + "/embedded.mobileprovision")
            try:
                devs = plistlib.loads(prof.encode()).get("ProvisionedDevices", [])
            except Exception:
                devs = []
            check("profile_has_device", UDID in devs, "device %s in embedded provisioning profile" % ("is" if UDID in devs else "is NOT"),
                  "rebuild with a connected device so Xcode registers it: wda-start does this (-allowProvisioningUpdates)")

    # wda reachability
    try:
        with urllib.request.urlopen(BASE + "/status", timeout=3) as r:
            st = json.loads(r.read())
        check("wda_running", True, "ready=%s" % st.get("value", {}).get("ready"))
    except Exception:
        check("wda_running", False, "no answer from %s/status" % BASE, "run: %s/wda-start" % WDA_HOME)

    # wda_running and the checks wda-start fixes on its own inform; every other failing check blocks starting
    blockers = [c for c in checks if not c["ok"] and c["name"] != "wda_running" and c["name"] not in BUILT_BY_START]
    running = any(c["name"] == "wda_running" and c["ok"] for c in checks)
    needs_build = any(c["name"] in BUILT_BY_START and not c["ok"] for c in checks)
    if blockers:
        next_step = blockers[0]["fix"]
    elif running:
        next_step = "WDA is up; use the ios-* commands"
    elif needs_build:
        next_step = "run wda-start; it builds the runner first"
    else:
        next_step = "run wda-start"
    result = {"ok": not blockers, "udid": UDID, "team": TEAM, "bundle_id": BUNDLE, "checks": checks, "next": next_step}
    print(json.dumps(result, indent=2))
    return 0 if result["ok"] else 1


sys.exit(main())
