#!/bin/bash
# start WDA on the phone and forward it to localhost:$WDA_PORT
# usage: IOS_UDID=<udid> wda-start [--dry-run]
set -u
. "$(dirname "$0")/wda-env.sh"

IDEVICE_ID="$(command -v idevice_id || echo /opt/homebrew/opt/libimobiledevice/bin/idevice_id)"
XCTESTRUN="$(ls "$WDA_DERIVED"/Build/Products/*.xctestrun 2>/dev/null | head -1)"
TEST_CMD=(xcodebuild test-without-building -xctestrun "${XCTESTRUN:-<built by wda-build>}" -destination "id=${IOS_UDID:-<udid>}")
PROXY_CMD=(iproxy -u "${IOS_UDID:-<udid>}" "$WDA_PORT:8100")

if [ "${1:-}" = "--dry-run" ]; then
  json ok:raw=true action=wda-start dry_run:raw=true "test_command=${TEST_CMD[*]}" "proxy_command=${PROXY_CMD[*]}" "base_url=$WDA_BASE_URL"
  exit 0
fi

need_udid
command -v iproxy >/dev/null || die missing_iproxy "iproxy not found" "fix=brew install libimobiledevice"
STATE_DIR="$(device_state "$IOS_UDID")"
mkdir -p "$STATE_DIR"
lock_port "$WDA_PORT"

if curl -sf -m 2 "$WDA_BASE_URL/status" >/dev/null; then
  # the port can belong to another phone's runner, so only reuse one whose runner and forward
  # this phone started on it are both still alive
  if pid_alive "$STATE_DIR/xcodebuild.pid" xcodebuild && proxy_serves "$STATE_DIR" "$IOS_UDID" "$WDA_PORT"; then
    json ok:raw=true action=wda-start already_running:raw=true "base_url=$WDA_BASE_URL" "udid=$IOS_UDID"
    exit 0
  fi
  die port_in_use "$WDA_BASE_URL already answers for another WDA" "fix=set WDA_PORT to a free port, or run wda-stop for the other phone"
fi

if [ -x "$IDEVICE_ID" ] && ! "$IDEVICE_ID" -l | grep -qx "$IOS_UDID"; then
  die device_not_on_usb "phone $IOS_UDID is not visible over USB" "fix=plug it in, unlock it, tap Trust, run wda-doctor"
fi

# rebuild when there are no products, they were built for another bundle id, or the profile does
# not include this device; a destination with the real UDID lets Xcode register the device and
# refresh the profile
APP="$WDA_DERIVED/Build/Products/Debug-iphoneos/WebDriverAgentRunner-Runner.app"
BUILT_ID="$(/usr/libexec/PlistBuddy -c 'Print CFBundleIdentifier' "$APP/Info.plist" 2>/dev/null)"
if [ -z "$XCTESTRUN" ] || [ "$BUILT_ID" != "$WDA_BUNDLE_ID.xctrunner" ] ||
  ! security cms -D -i "$APP/embedded.mobileprovision" 2>/dev/null | grep -q "$IOS_UDID"; then
  WDA_BUILD_DESTINATION="id=$IOS_UDID" "$(dirname "$0")/wda-build" >"$STATE_DIR/wda-build.json" || {
    cat "$STATE_DIR/wda-build.json"; exit 1; }
  XCTESTRUN="$(ls "$WDA_DERIVED"/Build/Products/*.xctestrun | head -1)"
  TEST_CMD=(xcodebuild test-without-building -xctestrun "$XCTESTRUN" -destination "id=$IOS_UDID")
fi

# stop this phone's leftovers from a previous run so its port and device session are free
IOS_UDID="$IOS_UDID" "$(dirname "$0")/wda-stop" >/dev/null 2>&1

nohup "${TEST_CMD[@]}" >"$STATE_DIR/wda.log" 2>&1 9>&- &
echo $! >"$STATE_DIR/xcodebuild.pid"
nohup "${PROXY_CMD[@]}" >"$STATE_DIR/iproxy.log" 2>&1 9>&- &
echo $! >"$STATE_DIR/iproxy.pid"
echo "$WDA_PORT" >"$STATE_DIR/port"

timeout="${WDA_START_TIMEOUT:-180}"
for ((i = 0; i < timeout; i++)); do
  # a forward that couldn't bind exits. Only a dead pid counts as exited here: until nohup execs
  # iproxy, the process doesn't carry its name yet. Ownership is checked before reporting success
  if ! kill -0 "$(cat "$STATE_DIR/iproxy.pid")" 2>/dev/null; then
    die proxy_exited "iproxy for $IOS_UDID exited; another process may hold port $WDA_PORT" \
      "log=$STATE_DIR/iproxy.log" "fix=check lsof -i :$WDA_PORT, or set WDA_PORT to a free port"
  fi
  if curl -sf -m 2 "$WDA_BASE_URL/status" >/dev/null && proxy_serves "$STATE_DIR" "$IOS_UDID" "$WDA_PORT"; then
    json ok:raw=true action=wda-start "base_url=$WDA_BASE_URL" "udid=$IOS_UDID" "log=$STATE_DIR/wda.log"
    exit 0
  fi
  if ! kill -0 "$(cat "$STATE_DIR/xcodebuild.pid")" 2>/dev/null; then
    die xcodebuild_exited "test-without-building exited before WDA answered; if the log mentions an untrusted developer, trust the certificate under Settings > General > VPN & Device Management and rerun" \
      "log=$STATE_DIR/wda.log" "log_tail=$(tail -n 15 "$STATE_DIR/wda.log")"
  fi
  sleep 1
done
die status_timeout "WDA did not answer /status within ${timeout}s; the phone must stay unlocked" "log=$STATE_DIR/wda.log" "log_tail=$(tail -n 15 "$STATE_DIR/wda.log")"
