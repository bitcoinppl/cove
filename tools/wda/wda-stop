#!/bin/bash
# stop the WDA test runs and iproxy forwards started by wda-start: the phone in IOS_UDID, or every
# phone when it is unset
# usage: [IOS_UDID=<udid>] wda-stop [--dry-run]
set -u
. "$(dirname "$0")/wda-env.sh"

dry=false
[ "${1:-}" = "--dry-run" ] && dry=true

if [ -n "$IOS_UDID" ]; then
  dirs=("$(device_state "$IOS_UDID")")
else
  dirs=("$WDA_STATE"/devices/*)
fi

stopped=()
for dir in "${dirs[@]}"; do
  [ -d "$dir" ] || continue
  for name in xcodebuild iproxy; do
    pidfile="$dir/$name.pid"
    [ -f "$pidfile" ] || continue
    if pid_alive "$pidfile" "$name"; then
      pid="$(cat "$pidfile")"
      if $dry; then
        stopped+=("$(basename "$dir"):$name:$pid(dry-run)")
        continue
      fi
      kill "$pid" 2>/dev/null
      # a restart binds the same port and device session right after this returns, so wait for
      # the process to exit, and force it after 5 s
      for _ in $(seq 50); do
        kill -0 "$pid" 2>/dev/null || break
        sleep 0.1
      done
      kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null
      stopped+=("$(basename "$dir"):$name:$pid")
    fi
    $dry || rm -f "$pidfile"
  done
  $dry || rm -f "$dir/port"
done

json ok:raw=true action=wda-stop "stopped=${stopped[*]:-none}" "dry_run:raw=$dry"
