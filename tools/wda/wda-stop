#!/bin/bash
# stop the WDA test run and the iproxy forward started by wda-start
# usage: wda-stop [--dry-run]
set -u
. "$(dirname "$0")/wda-env.sh"

stopped=()
for name in xcodebuild iproxy; do
  pidfile="$WDA_STATE/$name.pid"
  [ -f "$pidfile" ] || continue
  pid="$(cat "$pidfile")"
  # only signal a pid that is still the process we started, in case the pid was reused
  if kill -0 "$pid" 2>/dev/null && ps -p "$pid" -o comm= | grep -q "$name"; then
    if [ "${1:-}" = "--dry-run" ]; then
      stopped+=("$name:$pid(dry-run)")
      continue
    fi
    kill "$pid" 2>/dev/null
    stopped+=("$name:$pid")
  fi
  [ "${1:-}" = "--dry-run" ] || rm -f "$pidfile"
done

json ok:raw=true action=wda-stop "stopped=${stopped[*]:-none}" "dry_run:raw=$([ "${1:-}" = "--dry-run" ] && echo true || echo false)"
