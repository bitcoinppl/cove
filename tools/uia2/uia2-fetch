#!/bin/bash
# download the pinned UiAutomator2 server APKs into the cache and verify their checksums
# usage: uia2-fetch [--dry-run]
set -u
. "$(dirname "$0")/uia2-env.sh"

if [ "${1:-}" = "--dry-run" ]; then
  json ok:raw=true action=uia2-fetch dry_run:raw=true "version=$UIA2_SERVER_VERSION" "dir=$UIA2_APK_DIR"
  exit 0
fi

verify() { # verify FILE SHA256
  [ -f "$1" ] && [ "$(shasum -a 256 "$1" | cut -d' ' -f1)" = "$2" ]
}

if verify "$UIA2_SERVER_APK" "$UIA2_SERVER_SHA256" && verify "$UIA2_TEST_APK" "$UIA2_TEST_SHA256"; then
  json ok:raw=true action=uia2-fetch cached:raw=true "version=$UIA2_SERVER_VERSION" "dir=$UIA2_APK_DIR"
  exit 0
fi

command -v gh >/dev/null || die missing_gh "gh not found" "fix=brew install gh"
mkdir -p "$UIA2_APK_DIR"
# starts for different devices only lock their own device, so download into a private directory
# and rename each verified APK into the shared cache: rename is atomic on one filesystem, and an
# install that already opened the old file keeps reading it
tmp="$(mktemp -d "$UIA2_APK_DIR/.fetch.XXXXXX")" || die download_failed "could not create a download directory in $UIA2_APK_DIR"
trap 'rm -rf "$tmp"' EXIT
server_tmp="$tmp/$(basename "$UIA2_SERVER_APK")"
test_tmp="$tmp/$(basename "$UIA2_TEST_APK")"
gh release download "v$UIA2_SERVER_VERSION" -R appium/appium-uiautomator2-server -D "$tmp" >/dev/null 2>&1 ||
  die download_failed "gh release download v$UIA2_SERVER_VERSION failed" "fix=gh auth status"

verify "$server_tmp" "$UIA2_SERVER_SHA256" || die checksum_mismatch "server APK checksum differs from the pinned one" "path=$server_tmp"
verify "$test_tmp" "$UIA2_TEST_SHA256" || die checksum_mismatch "test APK checksum differs from the pinned one" "path=$test_tmp"
mv -f "$server_tmp" "$UIA2_SERVER_APK" && mv -f "$test_tmp" "$UIA2_TEST_APK" ||
  die download_failed "could not move the verified APKs into $UIA2_APK_DIR"
json ok:raw=true action=uia2-fetch cached:raw=false "version=$UIA2_SERVER_VERSION" "dir=$UIA2_APK_DIR"
